{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/manifest.json",
          "/favicon.svg",
          "/logo.png",
          "/icons/**",
          "/fonts/**",
          "/images/card-back.png",
          "/*.css",
          "/*.js",
          "!/eras-sw.js",
          "!/eras-pictures-sw.js"
        ]
      }
    },
    {
      "name": "engine",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/engine/*.json"]
      },
      "cacheQueryOptions": { "ignoreSearch": true }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/images/**", "/*.png", "/*.svg"]
      }
    }
  ],
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**", "!/api/**", "!/ws", "!/ws/**", "!/wake"]
}
